+// psram_alloc.h — allocator for large, low-traffic buffers.
+//
+// Bare-metal targets usually keep the RTOS heap in on-chip SRAM, which is far
+// too small for the observability buffers the runtime keeps around (the audio
+// capture ring alone is several MiB). With GBARECOMP_PSRAM_ALLOC those buffers
+// are served from the board's external PSRAM instead, while hot buffers stay
+// on the fast on-chip heap.
+
+#pragma once
+
+#include <cstddef>
+#include <memory>
+#include <new>
+
+#ifdef GBARECOMP_PSRAM_ALLOC
+
+extern "C" void *gba_psram_alloc(std::size_t size);
+extern "C" void  gba_psram_free(void *ptr);
+
+namespace gba {
+
+// Bump allocator over the device PSRAM arena. Blocks are handed out once at
+// bring-up and never returned, so deallocate() is a no-op.
+template <typename T>
+class PsramAllocator {
+public:
+    using value_type = T;
+
+    PsramAllocator() = default;
+    template <typename U>
+    PsramAllocator(const PsramAllocator<U>&) noexcept {}
+
+    T* allocate(std::size_t n) {
+        void* p = gba_psram_alloc(n * sizeof(T));
+        if (p == nullptr) throw std::bad_alloc();
+        return static_cast<T*>(p);
+    }
+    void deallocate(T* p, std::size_t) noexcept { gba_psram_free(p); }
+
+    template <typename U>
+    bool operator==(const PsramAllocator<U>&) const noexcept { return true; }
+    template <typename U>
+    bool operator!=(const PsramAllocator<U>&) const noexcept { return false; }
+};
+
+}  // namespace gba
+
+#else
+
+namespace gba {
+
+template <typename T>
+using PsramAllocator = std::allocator<T>;
+
+}  // namespace gba
+
+#endif  // GBARECOMP_PSRAM_ALLOC
